@model EmployeeManagementSystem.Models.Employee

<h2>Employee Details</h2>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Department</th>
        <td>@Model.Department?.Name</td>
    </tr>
    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>
    <tr>
        <th>Employee Type</th>
        <td>@Model.EmployeeType</td>
    </tr>
</table>

<a asp-action="Index"
   class="btn btn-primary">
    Back
</a>